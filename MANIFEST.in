include README.md LICENSE CHANGELOG.md CONTRIBUTING.md SECURITY.md
recursive-include docs *.md
recursive-include examples *.md *.py *.json
recursive-include tests *.py *.jsonl
recursive-include benchmarks *.py *.txt *.md *.json
recursive-include tools *.py *.txt *.h COPYING*
recursive-include tools/xkb/symbols *
recursive-include integrations *.md *.py
recursive-include .claude/skills *.md
prune tools/cache
global-exclude *.pyc __pycache__
